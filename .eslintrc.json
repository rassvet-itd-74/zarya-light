{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "rules": {
    // Two things this plugin's legacy Node resolver cannot follow, both of
    // which TypeScript resolves correctly on its own:
    //   - Vite asset query suffixes (?inline, ?url, ?raw), resolved at build
    //     time and type-checked through the vite/client declarations in
    //     forge.env.d.ts;
    //   - package "exports" subpaths such as vitest/config.
    "import/no-unresolved": [
      "error",
      { "ignore": ["\\?(inline|url|raw|worker)$", "^vitest/config$"] }
    ]
  },
  "overrides": [
    {
      // Hexagonal dependency direction: the domain core declares ports and is
      // never allowed to import what implements them. Inert until src/domain/
      // exists. See .claude/skills/zarya-hexagonal/ — if an import here fails,
      // the fix is a port, not an exception.
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "electron-*"],
                "message": "Domain core must not depend on Electron. Declare a port and implement it in src/adapters/electron/."
              },
              {
                "group": [
                  "ethers", "ethers/*", "viem", "viem/*", "web3", "web3-*",
                  "@ethersproject/*"
                ],
                "message": "Domain core must not depend on a chain library. Declare a port and implement it in src/adapters/chain/."
              },
              {
                "group": ["pdf-lib", "pdfjs-dist", "pdfjs-dist/*", "hummus", "pdfkit"],
                "message": "Domain core must not depend on a PDF library — it must not be able to read a form field at all. Declare a port and implement it in src/adapters/forms/."
              },
              {
                "group": [
                  "better-sqlite3", "sqlite3", "knex", "drizzle-orm",
                  "drizzle-orm/*", "typeorm", "prisma", "@prisma/*"
                ],
                "message": "Domain core must not depend on storage. Declare a port and implement it in src/adapters/store/."
              },
              {
                "group": ["node:*", "fs", "fs/*", "path", "crypto", "os", "child_process"],
                "message": "Domain core must be free of I/O and platform APIs. Needs randomness, time, or files? Declare a port (IdGenerator, Clock, FileSink)."
              },
              {
                "group": ["**/adapters/**", "**/app/**", "**/*.json"],
                "message": "Dependencies point inward. The domain must not import adapters, application services, or the ABI."
              }
            ]
          }
        ]
      }
    },
    {
      // Each foreign library is confined to the one adapter allowed to touch it.
      // The domain rule above already forbids all of them there; these close the
      // other direction — a chain module reaching for a PDF parser means
      // untrusted file parsing has escaped its boundary, and SQL outside
      // store/ means the storage engine is no longer swappable.
      //
      // Three overrides rather than one, because a later override **replaces**
      // this rule rather than merging with it. That is used deliberately: the
      // two directory-specific blocks below restate the rules their own
      // directory is still subject to, so exempting forms/ from the PDF rule
      // does not also exempt it from the database rule.
      "files": ["src/**/*.ts"],
      "excludedFiles": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["pdf-lib", "pdf-lib/*", "pdfjs-dist", "pdfjs-dist/*", "hummus", "pdfkit"],
                "message": "Only src/adapters/forms/ may import a PDF library. Parsing untrusted documents stays behind that boundary."
              },
              {
                "group": [
                  "node:sqlite", "sqlite", "better-sqlite3", "sqlite3", "knex",
                  "drizzle-orm", "drizzle-orm/*", "typeorm", "prisma", "@prisma/*"
                ],
                "message": "Only src/adapters/store/ may import a database driver. Everything else goes through a port, so the storage engine stays swappable and SQL stays in one directory."
              }
            ]
          }
        ]
      }
    },
    {
      // The forms adapter may import a PDF library and nothing else foreign.
      "files": ["src/adapters/forms/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:sqlite", "sqlite", "better-sqlite3", "sqlite3", "knex",
                  "drizzle-orm", "drizzle-orm/*", "typeorm", "prisma", "@prisma/*"
                ],
                "message": "The forms adapter must not reach the database. It receives an operation record through a port; see boundOperation.ts."
              }
            ]
          }
        ]
      }
    },
    {
      // The store adapter may import a database driver and nothing else foreign.
      "files": ["src/adapters/store/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["pdf-lib", "pdf-lib/*", "pdfjs-dist", "pdfjs-dist/*", "hummus", "pdfkit"],
                "message": "The store adapter must not parse documents. It persists bytes and rows; the forms adapter owns PDFs."
              }
            ]
          }
        ]
      }
    }
  ]
}
