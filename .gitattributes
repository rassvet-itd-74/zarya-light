# Normalize line endings so Cyrillic-bearing docs round-trip identically on
# Windows and CI. PowerShell 5.1 defaults to ANSI and will corrupt these files
# if written without -Encoding utf8 — see CLAUDE.md.
* text=auto eol=lf

*.md    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.mjs   text eol=lf

